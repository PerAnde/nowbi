// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// Model Usuario
model Usuario {
    id       String @id @default(uuid())
    name     String
    email    String @unique
    cpf_cnpj String @unique
    password String

    created_at DateTime @default(now())
    updated_at DateTime @default(now())

    empresas Empresa[]

    @@map("usuarios")
}

// Model Cliente
model Empresa {
    id           String  @id @default(uuid())
    name         String
    cnpj_empresa String?
    logo_empresa String?

    created_at DateTime @default(now())
    updated_at DateTime @default(now())

    usuario_id String
    usuario    Usuario @relation(fields: [usuario_id], references: [id])

    @@map("empresas")
}

model Categoria {
    id   String        @id @default(uuid())
    name String
    tipo TipoCategoria

    subcategorias SubCategoria[]

    created_at DateTime @default(now())
    updated_at DateTime @default(now())

    @@map("categorias")
}

model SubCategoria {
    id   String @id @default(uuid())
    name String

    categoria_id String
    categoria    Categoria @relation(fields: [categoria_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @default(now())

    @@map("sub_categorias")
}

enum TipoCategoria {
    RECEITA
    DESPESA
}


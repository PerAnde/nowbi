generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Usuario {
    id       String @id @default(uuid())
    name     String
    email    String @unique
    cpf_cnpj String @unique
    password String

    endereco      String? @db.VarChar(255)
    numero        String? @db.VarChar(10)
    bairro        String? @db.VarChar(100)
    cidade        String? @db.VarChar(100)
    codigo_cidade Int?
    estado        String? @db.VarChar(2)
    cep           String? @db.VarChar(10)
    telefone      String? @db.VarChar(13)

    categorias Categoria[]
    empresas   Empresa[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("usuarios")
}

model Empresa {
    id           String  @id @default(uuid())
    name         String
    cnpj_empresa String?
    logo_empresa String?

    usuario_id String
    usuario Usuario                @relation(fields: [usuario_id], references: [id])

    bis     BusinessIntelligence[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([usuario_id], map: "empresas_usuario_id_fkey")
    @@map("empresas")
}

model Categoria {
    id         String        @id @default(uuid())
    name       String
    tipo       TipoCategoria

    usuario_id String
    usuario    Usuario @relation(fields: [usuario_id], references: [id])

    subcategorias SubCategoria[]

    created_at DateTime      @default(now())
    updated_at DateTime      @updatedAt

    @@index([usuario_id], map: "categorias_usuario_id_fkey")
    @@map("categorias")
}

model SubCategoria {
    id   String @id @default(uuid())
    name String

    categoria_id String
    categoria    Categoria @relation(fields: [categoria_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([categoria_id], map: "sub_categorias_categoria_id_fkey")
    @@map("sub_categorias")
}

model BusinessIntelligence {
    id     String  @id @default(uuid())
    mes    String
    ano    Int
    status Boolean @default(false)

    empresa_id String
    empresa    Empresa @relation(fields: [empresa_id], references: [id])
    
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([empresa_id], map: "business_intelligence_empresa_id_fkey")
    @@map("business_intelligence")
}

enum TipoCategoria {
    RECEITA
    DESPESA
}

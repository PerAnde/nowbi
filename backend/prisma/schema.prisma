generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Usuario {
    id         String   @id @default(uuid())
    name       String
    email      String   @unique
    cpf_cnpj   String   @unique
    password   String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    dataFimPeriodoTeste DateTime
    isPeriodoTesteAtivo Boolean  @default(false)
    isPlanoAtivo        Boolean  @default(true)

    bairro      String? @db.VarChar(100)
    cep         String? @db.VarChar(10)
    cidade      String? @db.VarChar(100)
    endereco    String? @db.VarChar(255)
    estado      String? @db.VarChar(2)
    ibge        String? @db.VarChar(10)
    img_usuario String? @db.VarChar(255)
    numero      String? @db.VarChar(10)
    telefone    String? @db.VarChar(13)

    plano_id Int?
    plano    Plano? @relation(fields: [plano_id], references: [id])

    categorias     Categoria[]
    empresas       Empresa[]
    grupo_empresas GrupoEmpresa[]

    @@map("usuarios")
}

model Plano {
    id             Int       @id @default(autoincrement())
    nome           String    @unique
    descricao      String?
    valor          Decimal   @db.Decimal(10, 2)
    limiteEmpresas Int
    usuarios       Usuario[]

    @@map("planos")
}

model GrupoEmpresa {
    id          String    @id @default(uuid())
    name        String
    email_grupo String
    created_at  DateTime  @default(now())
    updated_at  DateTime  @updatedAt
    usuario_id  String?
    link_grupo  String
    empresas    Empresa[]
    usuario     Usuario?  @relation(fields: [usuario_id], references: [id])

    @@index([usuario_id], map: "grupo_empresas_usuario_id_fkey")
    @@map("grupo_empresas")
}

model Empresa {
    id               String   @id @default(uuid())
    name             String
    cnpj_empresa     String?
    logo_empresa     String?
    created_at       DateTime @default(now())
    updated_at       DateTime @updatedAt
    usuario_id       String
    grupo_empresa_id String?
    email_empresa    String
    link_bi          String   @unique @db.VarChar(40)
    pin_acesso       Int?

    mostrar_resumo    Boolean @default(true)
    mostrar_detalhes  Boolean @default(true)
    mostrar_dfc       Boolean @default(true)
    mostrar_dre       Boolean @default(true)
    mostrar_relatorio Boolean @default(true)

    categorias Categoria[] // NOVO 12-02

    bis              BusinessIntelligence[]
    grupo_empresa    GrupoEmpresa?          @relation(fields: [grupo_empresa_id], references: [id])
    usuario          Usuario                @relation(fields: [usuario_id], references: [id])
    blingIntegration BlingIntegration?
    subCategorias    SubCategoria[]

    @@index([usuario_id], map: "empresas_usuario_id_fkey")
    @@index([grupo_empresa_id], map: "empresas_grupo_empresa_id_fkey")
    @@map("empresas")
}

model BlingIntegration {
    id String @id @default(uuid())

    empresaId String  @unique
    empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

    accessToken  String @db.Text
    refreshToken String @db.Text

    scope       String?
    blingUserId String?

    expiresAt DateTime

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("bling_integrations")
}

model Categoria {
    id       String        @id @default(uuid())
    name     String
    tipo     TipoCategoria
    grupoDre GrupoDre

    empresaId String?  @map("empresa_id") // NOVO 12-02
    empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade) // NOVO 12-02

    id_externo String?
    origem     String? @default("MANUAL")

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    usuario_id String
    usuario    Usuario @relation(fields: [usuario_id], references: [id])

    lancamentoBi  LancamentoBi[]
    subcategorias SubCategoria[]

    @@unique([id_externo, origem, empresaId])
    @@index([usuario_id], map: "categorias_usuario_id_fkey")
    @@index([empresaId])
    @@map("categorias")
}

model SubCategoria {
    id           String @id @default(uuid())
    name         String
    categoria_id String

    empresaId String?  @map("empresa_id")
    empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

    origem String? @default("MANUAL")

    created_at   DateTime       @default(now())
    updated_at   DateTime       @updatedAt
    lancamentoBi LancamentoBi[]
    categoria    Categoria      @relation(fields: [categoria_id], references: [id], onDelete: Cascade) // NOVO 12-02

    @@index([categoria_id], map: "sub_categorias_categoria_id_fkey")
    @@map("sub_categorias")
}

model BusinessIntelligence {
    id           String         @id @default(uuid())
    mes          String
    ano          Int
    status       Boolean        @default(false)
    created_at   DateTime       @default(now())
    updated_at   DateTime       @updatedAt
    empresa_id   String
    empresa      Empresa        @relation(fields: [empresa_id], references: [id])
    lancamentoBi LancamentoBi[]

    relatorio_ia_gerado Boolean @default(false)

    observacoes_bi String?         @db.Text
    observacoes    ObservacoesBi[]

    @@index([empresa_id], map: "business_intelligence_empresa_id_fkey")
    @@map("business_intelligence")
}

model ObservacoesBi {
    id       String  @id @default(uuid())
    conteudo String? @db.LongText

    periodo_mes     String? @db.VarChar(255)
    resumo_geral    String? @db.LongText
    analise_receita String? @db.LongText
    analise_despesa String? @db.LongText
    pontos_atencao  String? @db.LongText
    recomendacoes   String? @db.LongText
    conclusao       String? @db.LongText

    businessIntelligence_id String   @unique
    created_at              DateTime @default(now())
    updated_at              DateTime @updatedAt

    businessIntelligence BusinessIntelligence @relation(fields: [businessIntelligence_id], references: [id])

    @@map("observacoes_bi")
}

model LancamentoBi {
    id                      String        @id @default(uuid())
    valor                   Decimal
    tipo                    TipoCategoria
    categoria_id            String
    subcategoria_id         String?
    businessIntelligence_id String

    id_externo_lancamento String? @unique

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    businessIntelligence BusinessIntelligence @relation(fields: [businessIntelligence_id], references: [id])
    categoria            Categoria            @relation(fields: [categoria_id], references: [id])
    subcategoria         SubCategoria?        @relation(fields: [subcategoria_id], references: [id])

    @@index([categoria_id], map: "lancamento_bi_categoria_id_fkey")
    @@index([subcategoria_id], map: "lancamento_bi_subcategoria_id_fkey")
    @@index([businessIntelligence_id], map: "lancamentos_bi_businessIntelligence_id_fkey")
    @@map("lancamentos_bi")
}

enum TipoCategoria {
    RECEITA
    DESPESA
}

enum GrupoDre {
    // PADRÃO
    NAO_EXIBIR_NO_DRE

    // RECEITAS
    RECEITA_OPERACIONAL_BRUTA
    RECEITA_FINANCEIRA
    OUTRAS_RECEITAS

    // DESPESAS
    DEDUCOES_DA_RECEITA_BRUTA
    CUSTO_VARIAVEL
    DESPESAS_OPERACIONAIS
    DESPESAS_FINANCEIRAS
    DESPESAS_VARIAVEIS
    OUTRAS_DESPESAS
    IR_CSLL
}
